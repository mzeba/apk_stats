# ==============================================================================
# Modèle de configuration — copiez ce fichier en `.env` et renseignez vos valeurs.
# NE JAMAIS committer le fichier `.env` réel ni la clé de compte de service.
# ==============================================================================

# Chemin ABSOLU vers la clé du compte de service Google Cloud (lecture seule sur
# le bucket). Variable standard reconnue par les bibliothèques GCP.
GOOGLE_APPLICATION_CREDENTIALS=/chemin/absolu/vers/service-account.json

# Nom du bucket Google Play Console (visible dans Play Console > Téléchargements).
EDM_BUCKET_NAME=pubsite_prod_XXXXXXXXXXXXXXXXXXX

# Liste des packages à analyser, séparés par des virgules.
EDM_PACKAGES=com.incubuo.mbem,com.incubuo.meg

# Liste des pays à ventiler (codes ISO 3166-1 alpha-2), séparés par des virgules.
# Une ligne par pays sera produite, en plus du total monde « Tous les pays ».
EDM_COUNTRIES=BF,CI,ML

# Intervalle d'analyse, bornes incluses. Formats acceptés : AAAA, AAAA-MM ou
# AAAA-MM-DD. Une borne partielle couvre l'année ou le mois entier
# (ex. début 2026 = 2026-01-01, fin 2026-05 = 2026-05-31).
EDM_START_PERIOD=2026-01
EDM_END_PERIOD=2026-05

# Granularité des résultats : yearly, monthly (défaut) ou daily.
EDM_FREQUENCY=monthly

# Fichier CSV de sortie.
EDM_OUTPUT=stats_mensuelles_burkina_vs_monde.csv
